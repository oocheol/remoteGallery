NODE_ENV=development
GALLERY_DB_DIR=.gallery-twin/pglite
GALLERY_STORAGE_DIR=.gallery-twin/storage
GALLERY_JOBS_DIR=.gallery-twin/jobs
WORKER_TOKEN=replace-with-a-long-random-token
RECONSTRUCTION_PYTHON=services/reconstruction/.venv/bin/python
GALLERY_WORKER_URL=http://127.0.0.1:3000
GALLERY_HOST=127.0.0.1
GALLERY_PORT=3000
GALLERY_SESSION_SECRET=replace-with-a-local-random-secret
NEXT_PUBLIC_APP_NAME=Gallery Twin

# Vercel only. Leave disabled for local PGlite / disk storage.
# GALLERY_CLOUD=1
# NEXT_PUBLIC_GALLERY_CLOUD=1
# DATABASE_URL=postgresql://...
# BLOB_READ_WRITE_TOKEN=...
# GALLERY_ADMIN_PASSWORD_HASH=64-character-sha256-hex
